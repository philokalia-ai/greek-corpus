# Copy to .env and fill in. .env is gitignored — never commit the real values.
#
#   cp .env.example .env
#
# The OCR pipeline also accepts the key straight from the environment, which is
# the better option in CI:
#
#   MISTRAL_API_KEY=... python3 pipeline/ocr_pdf.py ...

# Mistral API key, used for document OCR (https://console.mistral.ai/).
MISTRAL_API_KEY=

# WordPress publishing target for pipeline/publish_wordpress.py.
# WP_APP_PASSWORD is an Application Password (WP Admin > Users > Profile >
# Application Passwords), NOT the account login password. Revoke it when done.
WP_SITE_URL=https://taygetosbalcony.gr
WP_USERNAME=
WP_APP_PASSWORD=
