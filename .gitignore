# ---------------------------------------------------------------------------
# Secrets. Never commit an API key, token or password to this public repo.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
secrets.json
credentials.json
wp-credentials.*

# ---------------------------------------------------------------------------
# Source scans. These are large binaries (hundreds of MB) fetched on demand by
# pipeline/fetch_source.py; they are not part of the corpus itself.
# ---------------------------------------------------------------------------
sources/**/raw/
*.pdf

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Intermediate page renders (regenerated by pipeline/prepare_pages.py)
sources/**/pages/*.png
